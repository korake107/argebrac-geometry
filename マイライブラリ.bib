@misc{vafastringlandscapeswampland2005,
  title = {The {{String Landscape}} and the {{Swampland}}},
  author = {Vafa, Cumrun},
  year = 2005,
  month = oct,
  number = {arXiv:hep-th/0509212},
  eprint = {hep-th/0509212},
  publisher = {arXiv},
  doi = {10.48550/arXiv.hep-th/0509212},
  urldate = {2026-11-08},
  abstract = {Recent developments in string theory suggest that string theory landscape of vacua is vast. It is natural to ask if this landscape is as vast as allowed by consistent-looking effective field theories. We use universality ideas from string theory to suggest that this is not the case, and that the landscape is surrounded by an even more vast swampland of consistent-looking semiclassical effective field theories, which are actually inconsistent. Identification of the boundary of the landscape is a central question which is at the heart of the meaning of universality properties of consistent quantum gravitational theories. We propose certain finiteness criteria as one relevant factor in identifying this boundary (based on talks given at the Einstein Symposium in Alexandria, at the 2005 Simons Workshop in Mathematics and Physics, and the talk to have been presented at Strings 2005).},
  archiveprefix = {arXiv},
  keywords = {notion,Swampland},
  file = {/Users/kotakeryuto/Zotero/storage/X6VJ4X4U/Vafa - 2005 - The String Landscape and the Swampland.pdf;/Users/kotakeryuto/Zotero/storage/NJJA852E/0509212.html}
}

@misc{wadatertiaryinvariantdiscrete2026,
  title = {The Tertiary Invariant and Discrete {{Green-Schwarz}} Couplings in Heterotic String Theory},
  author = {Wada, Hiroki and Yonekura, Kazuya},
  year = 2026,
  month = nov,
  journal = {arXiv.org},
  urldate = {2026-11-11},
  abstract = {The tertiary invariant is a recently introduced pairing between two-dimensional \$\textbackslash mathcal\textbraceleft N\textbraceright =(0,1)\$ supersymmetric quantum field theories, motivated by topological modular forms. We evaluate it directly from its definition for the sigma models on \$\textbackslash mathrm\textbraceleft Sp\textbraceright (2)\$ and \$\textbackslash mathrm\textbraceleft SU\textbraceright (3)\$ with unit \$H\$-flux, paired with the internal theories of the non-supersymmetric \$\textbackslash mathfrak\textbraceleft so\textbraceright (16)\textbackslash oplus\textbackslash mathfrak\textbraceleft so\textbraceright (16)\$ heterotic string and of the near-horizon region of the non-supersymmetric heterotic 6-brane, respectively. Regarding the target spaces as \$S\textasciicircum 3\$ bundles over spheres, we fill in every fiber with a four-disk carrying a gauge instanton and reduce the invariant to the index of a Dirac operator on the base. We find nonzero values of order three and two, which determine the Green-Schwarz couplings of the two theories on \$\textbackslash mathrm\textbraceleft Sp\textbraceright (2)\$ and \$\textbackslash mathrm\textbraceleft SU\textbraceright (3)\$, respectively. The former, a \$\textbackslash mathbb\textbraceleft Z\textbraceright\_\textbraceleft 3\textbraceright\$-valued discrete topological term of the \$\textbackslash mathfrak\textbraceleft so\textbraceright (16)\textbackslash oplus\textbackslash mathfrak\textbraceleft so\textbraceright (16)\$ theory, was previously studied through anomaly inflow to NS5-branes. Our computation, which uses only the worldsheet theories, agrees exactly with that result and thus confirms the anomaly inflow.},
  howpublished = {https://arxiv.org/abs/2611.11731v1},
  langid = {english},
  keywords = {Heterotic},
  file = {/Users/kotakeryuto/Zotero/storage/RWAUP6VU/Wada と Yonekura - 2026 - The tertiary invariant and discrete Green-Schwarz couplings in heterotic string theory.pdf}
}
